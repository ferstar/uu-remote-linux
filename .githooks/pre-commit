#!/usr/bin/env bash
set -euo pipefail

# Only run Rust checks when Rust/Cargo files are staged
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE "\.(rs|toml)$|Cargo\.lock$"; then
    exit 0
fi

echo "[pre-commit] Checking formatting (cargo fmt --check)..."
cargo fmt --all -- --check

echo "[pre-commit] Running clippy (cargo clippy -- -D warnings)..."
cargo clippy --features wayland,inproc-av --all-targets --no-deps -- -D warnings
